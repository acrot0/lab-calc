node_modules/
dist/
*.local
.DS_Store
__pycache__/
.playwright-mcp/

# Desktop build output. The ICO is committed (it is a small generated asset the
# repo should be able to reproduce from source, and make-icons.mjs regenerates
# it), but the packaged app is a 322 MB tree that belongs in releases/.
dist-desktop/
releases/

# Session logs a hook writes here. The workspace keeps its memory at the
# workspace root; this directory is a byproduct of running from inside the
# project and is not part of the app.
memory/

# Harness telemetry (compact snapshots, per-agent cost logs) — byproducts of a
# session, not part of the app. src/calc/docs/ is the same thing written to the
# wrong directory by an earlier run.
docs/maintain-logs/
src/calc/docs/

# Scratch space for one-off investigation scripts and fetched source data —
# the audit that produced element-discovery.mjs lived here, and so did the
# Material 3 and iOS navigation specifications the phone layout is based on.
# Never part of the app, and 3 MB of HTML and JSON is not something to commit
# by accident. The `-` form is a second directory that a leading-dot pattern
# does not match.
.tmp/
.tmp-*/

# Scratch space for work in progress; removed before the branch is finished.
.scratch/

# Rust build output for the Tauri shell. `src-tauri/target/` is the Cargo
# equivalent of node_modules: several GB of compiled dependencies that are
# reproduced from Cargo.lock. `src-tauri/gen/` holds schemas Tauri generates
# on first build.
src-tauri/target/
src-tauri/gen/

# Capacitor's Gradle output and local SDK path. The Android project itself is
# committed — it is the source of a reproducible build — but `build/` and
# `.gradle/` are outputs, and `local.properties` records this machine's SDK
# location, which is not true on any other.
android/build/
android/.gradle/
android/local.properties
android/app/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/capacitor-cordova-android-plugins/
